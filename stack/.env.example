# Copie para `stack/.env` (que é gitignored) e ajuste. `make init` faz isso.
#
# Aqui ficam apenas valores NÃO sensíveis. Senhas e tokens vão para
# stack/secrets/ como arquivos, montados via `secrets:` no Compose.

# Porta publicada do proxy no host (sempre em 127.0.0.1).
EDGE_PORT=8080
# Endereço que o Caddy escuta DENTRO do container. Troque por um domínio real
# (ex.: links.exemplo.com) e ligue AUTO_HTTPS para o Caddy emitir certificado.
SITE_ADDRESS=:8080
AUTO_HTTPS=off
# URL pública usada pela API para montar o short_url devolvido.
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_DB=links
POSTGRES_USER=links

REDIS_MAXMEMORY=128mb
LOG_LEVEL=info

# Somente em dev (compose.dev.yaml publica estas portas em 127.0.0.1).
API_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379
WORKER_METRICS_PORT=9100

# Somente com o profile `obs`.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
