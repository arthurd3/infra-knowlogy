# Secrets — never commit real ones. Only *.example is versioned.
stack/secrets/*
!stack/secrets/*.example
!stack/secrets/.gitkeep
.env
stack/.env

# Build output
site/dist/
site/.astro/
# Cache do vitest quando se roda com --reporter=json.
site/.vitest/
site/node_modules/
node_modules/
stack/services/api-go/bin/

# Generated reports
tools/reports/
*.sbom.json
*.trivy.json

# Kubeconfig do cluster kind local (gerado pelo k8s-up.sh, varia por máquina)
k8s/.kubeconfig

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Configuração local do Claude Code (por máquina)
.claude/settings.local.json
# Configuração local de servidores MCP: aponta para um Qdrant em localhost e
# varia por máquina. O formato esperado está documentado no CLAUDE.md.
.mcp.json

# ─── Módulo 4 (IaC) ──────────────────────────────────────────────────────────
# O estado guarda a senha do Postgres em texto puro (é o assunto de uma lição
# inteira) e o lock do provider é versionado, mas nada abaixo é.
iac/.terraform/
iac/.plugin-cache/
iac/*.tfstate
iac/*.tfstate.*
iac/*.tfplan
iac/.tofu-*
