// O pipeline da stack, no Jenkins.
//
// Ele espelha .github/workflows/ci.yml de propósito: os dois constroem as
// MESMAS imagens, a partir dos mesmos Dockerfiles, para que a comparação
// entre os dois mundos seja medida e não opinada.
//
// Três coisas que valem atenção:
//
//   1. `agent { label 'builder' }` não é decoração. O controller tem 0
//      executores; sem o label o build ficaria eternamente na fila, e o
//      `why` do item diria "Waiting for next available executor".
//   2. Nenhum estágio chama `docker`. O agente não tem o binário. Tudo passa
//      pelo buildctl, que fala com um buildkitd rootless (ADR 0011).
//   3. O checkout vem do SCM do job: o CI constrói o que está COMMITADO, não
//      o seu working tree.
//
// E uma pegadinha que só aparece medindo: o campo `builtOn` de um build de
// Pipeline é STRING VAZIA mesmo quando todos os estágios rodaram no agente.
// Ele reporta onde o executor "flyweight" do pipeline ficou — no controller —
// e não onde o trabalho aconteceu. Quem prova que o build saiu do controller é
// a linha `Running on builder` do console.

pipeline {
    agent { label 'builder' }

    options {
        // Sem `timestamps()`: ele exige o plugin timestamper, e este módulo
        // ensina cadeia de suprimentos — cada plugin a mais é superfície a
        // mais para escanear e justificar. O linter declarativo do próprio
        // Jenkins recusa a opção quando o plugin não está instalado, o que é
        // como este comentário nasceu.
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        BUILDKIT_HOST = 'unix:///run/buildkit/buildkitd.sock'
        OUT = 'out'
        REGISTRY = 'registry:5000'
        // A senha vazia é deliberada e está explicada em cicd-up.sh: guardar
        // uma senha ao lado da chave não protege de nada. Num ambiente de
        // verdade a chave vive num KMS.
        COSIGN_PASSWORD = ''
    }

    stages {
        stage('lint') {
            steps {
                sh '''
                    set -eu
                    buildctl build \
                      --frontend dockerfile.v0 \
                      --local context=. \
                      --local dockerfile=cicd/lint \
                      --output type=tar,dest=/dev/null
                '''
            }
        }

        stage('build') {
            steps {
                sh '''
                    set -eu
                    mkdir -p "$OUT"

                    # Os três serviços que o ci.yml também constrói, com o
                    # mesmo `target`. A saída é um tarball por imagem — o
                    # mesmo padrão do scan.sh, que escaneia um `docker save`
                    # em vez de falar com o socket.
                    # Duas saídas na MESMA build: um tarball para escanear e
                    # arquivar, e um push para o registry. Construir duas vezes
                    # produziria dois artefatos diferentes — e aí "o que foi
                    # escaneado" e "o que foi publicado" deixariam de ser a
                    # mesma coisa, que é o buraco que a cadeia de suprimentos
                    # existe para fechar.
                    #
                    # `registry.insecure=true` porque o registry local é HTTP.
                    # Num registry de verdade isso sai, e é a única linha aqui
                    # que muda.
                    build_one() {
                        svc="$1"; ctx="$2"
                        echo "── $svc  (contexto: $ctx)"
                        buildctl build \
                          --frontend dockerfile.v0 \
                          --local context="$ctx" \
                          --local dockerfile="$ctx" \
                          --opt target=dist \
                          --output type=docker,name=infra-knowlogy/$svc:ci,dest="$OUT/$svc.tar" \
                          --output type=image,name=$REGISTRY/infra-knowlogy/$svc:ci,push=true,registry.insecure=true \
                          --metadata-file "$OUT/$svc.meta.json"
                    }

                    build_one api-go    stack/services/api-go
                    build_one worker-py stack/services/worker-py
                    build_one web       site

                    ls -la "$OUT"
                '''
            }
        }

        stage('scan') {
            steps {
                sh '''
                    set -eu
                    # `--input` escaneia o TARBALL, sem falar com daemon nenhum
                    # — é o mesmo padrão do tools/scripts/scan.sh do módulo 1,
                    # que evita o socket de propósito.
                    #
                    # A distinção que o scan.sh faz e que vale aqui: "o scanner
                    # quebrou" e "o scanner achou CVE" são coisas diferentes.
                    # O --exit-code 1 só vale para o segundo caso; erro de
                    # execução sai com outro código e o `set -e` o propaga.
                    for tar in "$OUT"/*.tar; do
                        echo "── trivy $(basename "$tar")"
                        trivy image \
                          --input "$tar" \
                          --severity HIGH,CRITICAL \
                          --ignore-unfixed \
                          --ignorefile tools/trivyignore.yaml \
                          --exit-code 1 \
                          --no-progress \
                          --scanners vuln
                    done
                '''
            }
        }

        stage('sign') {
            steps {
                sh '''
                    set -eu
                    # Lê `containerimage.digest` do metadata do buildctl.
                    #
                    # Sem jq e sem python no agente de propósito: o único
                    # interpretador que ele precisa ter é o shell. O formato
                    # aqui é conhecido e estável (JSON plano do buildctl), e um
                    # `grep -o` num campo que não existisse devolveria vazio —
                    # o `set -eu` e o `[ -n ]` abaixo transformam isso em falha
                    # em vez de numa assinatura de referência errada.
                    meta_digest() {
                        d=$(grep -o '"containerimage.digest"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" \
                            | sed 's/.*"\(sha256:[a-f0-9]*\)".*/\1/')
                        [ -n "$d" ] || { echo "sem digest em $1" >&2; exit 1; }
                        printf '%s' "$d"
                    }

                    # Assina POR DIGEST, nunca por tag: tag é ponteiro mutável
                    # (lição 2), e assinar um ponteiro assina o que ele apontar
                    # amanhã. O digest sai do `--metadata-file` do próprio
                    # build — é o que ACABOU de ser publicado, sem uma segunda
                    # consulta ao registry que poderia devolver outra coisa.
                    #
                    # `--allow-http-registry` e não `--allow-insecure-registry`:
                    # o segundo permite TLS inválido, e o registry local fala
                    # HTTP puro. Com a flag errada o erro é
                    # `server gave HTTP response to HTTPS client`.
                    for svc in api-go worker-py web; do
                        digest=$(meta_digest "$OUT/$svc.meta.json")
                        ref="$REGISTRY/infra-knowlogy/$svc@$digest"
                        echo "── cosign sign $ref"
                        cosign sign --yes --allow-http-registry \
                          --key /run/secrets/cosign.key "$ref"
                    done
                '''
            }
        }

        stage('verify') {
            steps {
                sh '''
                    set -eu
                    # Lê `containerimage.digest` do metadata do buildctl.
                    #
                    # Sem jq e sem python no agente de propósito: o único
                    # interpretador que ele precisa ter é o shell. O formato
                    # aqui é conhecido e estável (JSON plano do buildctl), e um
                    # `grep -o` num campo que não existisse devolveria vazio —
                    # o `set -eu` e o `[ -n ]` abaixo transformam isso em falha
                    # em vez de numa assinatura de referência errada.
                    meta_digest() {
                        d=$(grep -o '"containerimage.digest"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" \
                            | sed 's/.*"\(sha256:[a-f0-9]*\)".*/\1/')
                        [ -n "$d" ] || { echo "sem digest em $1" >&2; exit 1; }
                        printf '%s' "$d"
                    }

                    # Assinar sem verificar é fé. Este estágio existe para o
                    # pipeline provar a própria assinatura antes de chamar o
                    # artefato de confiável.
                    for svc in api-go worker-py web; do
                        digest=$(meta_digest "$OUT/$svc.meta.json")
                        ref="$REGISTRY/infra-knowlogy/$svc@$digest"
                        echo "── cosign verify $ref"
                        cosign verify --allow-http-registry \
                          --key /run/secrets/cosign.pub "$ref" >/dev/null
                        echo "   assinatura confere"
                    done
                '''
            }
        }

        stage('archive') {
            steps {
                archiveArtifacts artifacts: 'out/*.tar', fingerprint: true
            }
        }
    }

    post {
        always {
            sh 'rm -rf "$OUT" || true'
        }
    }
}
