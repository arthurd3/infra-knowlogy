// O que o mascaramento de credencial do Jenkins faz — e o que ele não faz.
//
// Este pipeline TEM que passar: ele não testa nada, ele DEMONSTRA. E o que
// demonstra contraria o exemplo que mais se repete na internet.
//
// A versão difundida diz: "`echo $TOK | base64` vaza o segredo, porque o
// Jenkins só procura o valor literal". Medido aqui, no Jenkins 2.568.3 com
// credentials-binding 728, isso é FALSO — o plugin registra também as formas
// codificadas comuns, e o base64 sai mascarado.
//
// O que não muda é a conclusão, e ela fica até mais afiada: mascaramento é
// CASAMENTO DE PADRÃO sobre um conjunto conhecido de representações. Sai do
// conjunto e o segredo passa inteiro. Inverter, truncar, tirar um caractere,
// espaçar os bytes — qualquer uma dessas basta.
//
// Mascaramento é higiene de log. Tratá-lo como fronteira de segurança é
// confiar numa porta que só tranca quando o ladrão usa a maçaneta.
pipeline {
    agent { label 'builder' }
    options { timeout(time: 5, unit: 'MINUTES') }

    stages {
        stage('o que o mascaramento pega') {
            steps {
                withCredentials([string(credentialsId: 'registry-token', variable: 'TOK')]) {
                    sh '''
                        printf "%s" "$TOK"             | sed "s/^/direto:  /"
                        printf "%s" "$TOK" | base64    | sed "s/^/base64:  /"
                        echo
                    '''
                }
            }
        }

        stage('o que escapa') {
            steps {
                withCredentials([string(credentialsId: 'registry-token', variable: 'TOK')]) {
                    sh '''
                        printf "%s" "$TOK" | rev          | sed "s/^/invertido: /"
                        printf "%s" "$TOK" | cut -c1-12   | sed "s/^/truncado:  /"
                        printf "%s" "$TOK" | tr -d "-"    | sed "s/^/sem-ifen:  /"
                        printf "%s" "$TOK" | od -An -c | tr -s " " | head -1 | sed "s/^/espacado: /"
                    '''
                }
            }
        }
    }
}
