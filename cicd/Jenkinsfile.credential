// O que o mascaramento de credencial do Jenkins faz — e o que ele não faz.
//
// Este pipeline TEM que passar. O que ele demonstra é desconfortável: a
// primeira linha sai mascarada, a segunda vaza o segredo inteiro. O Jenkins
// procura o valor literal no log e o substitui por asteriscos; qualquer
// transformação — base64, reverse, um caractere a mais no meio — produz uma
// string que ele não reconhece e não mascara.
//
// Mascaramento é higiene de log. Não é fronteira de segurança, e tratá-lo
// como fronteira é como confiar numa porta que só tranca quando o ladrão bate.
pipeline {
    agent { label 'builder' }
    options { timeout(time: 5, unit: 'MINUTES') }

    stages {
        stage('o que o mascaramento faz') {
            steps {
                withCredentials([string(credentialsId: 'registry-token', variable: 'TOK')]) {
                    sh 'echo "direto: $TOK"'
                }
            }
        }

        stage('o que ele nao faz') {
            steps {
                withCredentials([string(credentialsId: 'registry-token', variable: 'TOK')]) {
                    // O mesmo segredo, transformado. O Jenkins não reconhece a
                    // forma nova e a deixa passar inteira.
                    sh 'printf "%s" "$TOK" | base64 | sed "s/^/base64: /"'
                }
            }
        }
    }
}
