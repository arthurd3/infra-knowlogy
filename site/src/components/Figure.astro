---
/**
 * Moldura de toda figura do site — desenho ou imagem.
 *
 * O padrão continua sendo SVG escrito à mão: ele herda as cores do tema pelas
 * custom properties (ver `.figure svg` em global.css), continua legível em
 * qualquer zoom, entra no `git diff` como texto e pesa alguns kilobytes. Uma
 * imagem raster não faz nada disso — em particular, ela não acompanha a troca
 * de tema.
 *
 * Mesmo assim `src` existe (ADR 0010): há figuras que valem mais como a coisa
 * original — uma captura de tela, um diagrama canônico que o leitor vai
 * reencontrar na documentação oficial, uma foto. Quando `src` é usado,
 * `credit` e `creditUrl` viram obrigatórios pelo teste: imagem sem procedência
 * é imagem de origem desconhecida, e este repositório não publica isso.
 *
 * `redrawnFrom` é o meio-termo e o caminho preferido: o desenho é SVG daqui,
 * mas a legenda diz de onde a ideia veio. Dá tema escuro E procedência.
 *
 * `viz-root` vem junto porque é onde a paleta categórica (--viz-1..3) é
 * definida — a mesma já validada para contraste nos gráficos.
 */
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  /** Legenda abaixo do desenho. Aceita <b> e <code>. */
  caption?: string;
  /** Texto alternativo, para quem usa leitor de tela. */
  alt?: string;
  /** Caminho de uma imagem em site/public/. Sem ele, o conteúdo vem do slot. */
  src?: string;
  /** Quem produziu a imagem ou o desenho original. */
  credit?: string;
  /** Onde está o original. */
  creditUrl?: string;
  /** Sob que licença. Ex.: "CC BY 4.0". */
  license?: string;
  /** Para SVG daqui que reencena um diagrama de outra pessoa. */
  redrawnFrom?: string;
  /**
   * Fundo para a imagem. `light` põe uma placa clara atrás dela.
   *
   * Quase todo diagrama publicado na internet foi desenhado para fundo branco
   * e tem texto preto com fundo transparente. Servido cru no tema escuro, ele
   * vira texto preto sobre quase-preto. A placa é a admissão honesta do custo
   * que o ADR 0010 registra: a imagem de fora não acompanha o tema, então ela
   * ganha o tema dela.
   */
  plate?: "light" | "none";
}
const { caption, alt, src, credit, creditUrl, license, redrawnFrom, plate = "none" } = Astro.props;

const lang: Lang = Astro.url.pathname.startsWith("/en/") ? "en" : "pt";
const t = useTranslations(lang);

const creditLabel = redrawnFrom ? t("figure.redrawn") : t("figure.source");
const creditText = redrawnFrom ?? credit;
---
<figure class="figure viz-root">
  {src ? (
    <div class={`figure__canvas figure__canvas--raster${plate === "light" ? " figure__canvas--plate" : ""}`}>
      <img src={src} alt={alt ?? ""} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="figure__canvas" role={alt ? "img" : undefined} aria-label={alt}>
      <slot />
    </div>
  )}

  <slot name="legend" />

  {creditText && (
    <p class="figure__credit">
      {creditLabel}:{" "}
      {creditUrl
        ? <a href={creditUrl} rel="noopener noreferrer" target="_blank">{creditText}</a>
        : <span>{creditText}</span>}
      {license && <> · {t("figure.license")}: <span class="figure__license">{license}</span></>}
    </p>
  )}

  {caption && <figcaption set:html={caption} />}
</figure>
