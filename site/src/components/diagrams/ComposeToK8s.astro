---
/** k8s-02 — um bloco de serviço do Compose vira quantos objetos. */
import Figure from "../Figure.astro";
import type { Lang } from "../../i18n/ui";

const lang: Lang = Astro.url.pathname.startsWith("/en/") ? "en" : "pt";
const C = {
  pt: {
    left: "um bloco no compose.yaml", right: "os objetos equivalentes",
    lines34: "34 linhas", lines96: "96 linhas",
    same: "não muda: a imagem e a aplicação",
    cost: "quase 3× mais linhas — e é uma troca, não desperdício",
    explicit: "as linhas a mais declaram o que o Compose deixava implícito",
    caption:
      "Cada linha do bloco à esquerda vira um objeto com nome próprio à direita. O que parecia inflação de YAML é <b>explicitação</b>: quantas réplicas, o que é estar pronto, quem fala com quem, o que acontece durante um update. O Compose era mais curto porque decidia menos.",
    alt: "Mapeamento de um bloco de serviço do Compose para Deployment, Service, NetworkPolicy, Secret e limites.",
  },
  en: {
    left: "one block in compose.yaml", right: "the equivalent objects",
    lines34: "34 lines", lines96: "96 lines",
    same: "unchanged: the image and the application",
    cost: "nearly 3× more lines — and it is a trade, not waste",
    explicit: "the extra lines declare what Compose left implicit",
    caption:
      "Every line of the block on the left becomes an object with a name of its own on the right. What looks like YAML inflation is <b>making things explicit</b>: how many replicas, what ready means, who may talk to whom, what happens during an update. Compose was shorter because it decided less.",
    alt: "Mapping from a Compose service block to Deployment, Service, NetworkPolicy, Secret and limits.",
  },
}[lang];

const pairs = [
  ["image / command", "Deployment", "dg-box--accent"],
  ["ports / expose", "Service", "dg-box--accent"],
  ["networks:", "NetworkPolicy", "dg-box--warn"],
  ["secrets:", "Secret → /run/secrets/", "dg-box--raised"],
  ["deploy.resources", "resources.limits", "dg-box--raised"],
  ["healthcheck:", "livenessProbe + readinessProbe", "dg-box--warn"],
  ["stop_grace_period", "terminationGracePeriodSeconds", "dg-box--raised"],
];
---
<Figure caption={C.caption} alt={C.alt}>
  <svg viewBox="0 0 700 290" xmlns="http://www.w3.org/2000/svg" font-size="11">
    <defs>
      <marker id="ck-arrow" viewBox="0 0 10 10" refX="8" refY="5"
              markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--border-strong)" />
      </marker>
    </defs>

    <text x="16" y="14" class="dg-title" font-size="12">{C.left}</text>
    <text x="16" y="28" class="dg-faint" font-size="9.5">{C.lines34}</text>
    <text x="684" y="14" text-anchor="end" class="dg-title" font-size="12">{C.right}</text>
    <text x="684" y="28" text-anchor="end" class="dg-faint" font-size="9.5">{C.lines96}</text>

    {pairs.map(([from, to, cls], i) => (
      <g>
        <rect x={16} y={40 + i * 32} width={198} height={24} rx={5} class="dg-box" />
        <text x={28} y={56 + i * 32} class="dg-mono" font-size="10">{from}</text>
        <path d={`M216 ${52 + i * 32} L${286} ${52 + i * 32}`} class="dg-line" marker-end="url(#ck-arrow)" />
        <rect x={290} y={40 + i * 32} width={252} height={24} rx={5} class={`dg-box ${cls}`} />
        <text x={302} y={56 + i * 32} class="dg-mono" font-size="10">{to}</text>
      </g>
    ))}

    <!-- A coluna que NÃO muda -->
    <rect x="566" y="40" width="118" height="184" rx={8} class="dg-box dg-box--dashed" />
    <text x="625" y="122" text-anchor="middle" class="dg-muted" font-size="10" font-weight="620">
      <tspan x="625" dy="0">{C.same.split(":")[0]}:</tspan>
      <tspan x="625" dy="16" class="dg-faint" font-weight="400">{C.same.split(":")[1]}</tspan>
    </text>

    <text x="16" y="256" class="dg-muted" font-size="10" font-weight="620">{C.cost}</text>
    <text x="16" y="272" class="dg-faint" font-size="9.5">{C.explicit}</text>
  </svg>
</Figure>
