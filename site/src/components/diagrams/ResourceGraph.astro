---
/** iac-04 — o grafo, e a diferença entre aresta implícita e explícita. */
import Figure from "../Figure.astro";
import type { Lang } from "../../i18n/ui";

const lang: Lang = Astro.url.pathname.startsWith("/en/") ? "en" : "pt";
const C = {
  pt: {
    implicit: "implícita — nasceu de uma referência",
    explicit: "explícita — depends_on, escrita à mão",
    why: "o edge não referencia a api: quem a nomeia é o Caddyfile, que o tofu não lê",
    par: "sem aresta entre eles, os dois sobem em PARALELO",
    reverse: "no destroy, o grafo é percorrido ao contrário",
    code: "POSTGRES_HOST=${docker_container.db.name}",
    caption:
      "Ninguém escreveu a ordem. A aresta <b>api → db</b> existe porque <code>POSTGRES_HOST</code> referencia o recurso: o valor só é conhecido depois de o db existir, então o grafo deriva a dependência sozinho. Já <b>edge → api</b> precisou de <code>depends_on</code>, porque nenhum dado flui entre os dois — quem nomeia a api é o Caddyfile, um arquivo que o <code>tofu</code> não lê. <code>depends_on</code> é a exceção honesta, não o padrão.",
    alt: "Grafo de dependências com arestas implícitas por referência e uma aresta explícita por depends_on.",
  },
  en: {
    implicit: "implicit — born from a reference",
    explicit: "explicit — depends_on, written by hand",
    why: "edge does not reference api: the Caddyfile names it, and tofu never reads that file",
    par: "with no edge between them, the two come up in PARALLEL",
    reverse: "on destroy, the graph is walked backwards",
    code: "POSTGRES_HOST=${docker_container.db.name}",
    caption:
      "Nobody wrote the order. The <b>api → db</b> edge exists because <code>POSTGRES_HOST</code> references the resource: the value is only known once db exists, so the graph derives the dependency by itself. <b>edge → api</b>, on the other hand, needed <code>depends_on</code>, because no data flows between them — the Caddyfile names the api, and <code>tofu</code> never reads that file. <code>depends_on</code> is the honest exception, not the default.",
    alt: "Dependency graph with implicit edges from references and one explicit depends_on edge.",
  },
}[lang];

const nodes = [
  { id: "db", x: 40, y: 150, cls: "dg-box--raised" },
  { id: "cache", x: 40, y: 32, cls: "dg-box--raised" },
  { id: "api", x: 252, y: 92, cls: "dg-box--accent" },
  { id: "worker", x: 252, y: 186, cls: "dg-box--raised" },
  { id: "web", x: 464, y: 32, cls: "dg-box--raised" },
  { id: "edge", x: 464, y: 122, cls: "dg-box--warn" },
];
---
<Figure caption={C.caption} alt={C.alt}>
  <svg viewBox="0 0 700 280" xmlns="http://www.w3.org/2000/svg" font-size="11">
    <defs>
      <marker id="rg-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="dg-fill-accent" />
      </marker>
      <marker id="rg-w" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="dg-fill-warn" />
      </marker>
    </defs>

    <path d="M252 112 L166 68" class="dg-line dg-line--accent" fill="none" marker-end="url(#rg-a)" />
    <path d="M252 122 L166 164" class="dg-line dg-line--accent" fill="none" marker-end="url(#rg-a)" />
    <path d="M252 202 L166 180" class="dg-line dg-line--accent" fill="none" marker-end="url(#rg-a)" />
    <path d="M252 210 L166 78" class="dg-line dg-line--accent" fill="none" marker-end="url(#rg-a)" />
    <path d="M464 142 L378 122" class="dg-line dg-line--warn" fill="none" marker-end="url(#rg-w)" />
    <path d="M464 150 q-60 60 -140 20" class="dg-line dg-line--warn dg-line--dashed" fill="none" marker-end="url(#rg-w)" />

    {nodes.map((n) => (
      <g>
        <rect x={n.x} y={n.y} width={126} height={40} rx={7} class={`dg-box ${n.cls}`} />
        <text x={n.x + 63} y={n.y + 25} text-anchor="middle" class="dg-mono dg-title" font-size="11.5">{n.id}</text>
      </g>
    ))}

    <text x="176" y="118" class="dg-faint" font-size="9">{C.implicit}</text>
    <text x="396" y="108" text-anchor="end" class="dg-muted" font-size="9" font-weight="620">{C.explicit}</text>
    <text x="40" y="242" class="dg-mono dg-faint" font-size="9">{C.code}</text>
    <text x="40" y="258" class="dg-faint" font-size="9">{C.why}</text>
    <text x="686" y="242" text-anchor="end" class="dg-faint" font-size="9">{C.par}</text>
    <text x="686" y="258" text-anchor="end" class="dg-faint" font-size="9">{C.reverse}</text>
  </svg>
</Figure>
