---
/** iac-07 — os três caminhos de um segredo, e onde cada um termina. */
import Figure from "../Figure.astro";
import type { Lang } from "../../i18n/ui";

const lang: Lang = Astro.url.pathname.startsWith("/en/") ? "en" : "pt";
const C = {
  pt: {
    src: "a senha, num arquivo",
    paths: [
      { t: "environment:", s: "o valor vira variável", end: "docker inspect · /proc/pid/environ · estado", cls: "dg-box--danger", verdict: "vaza em três lugares" },
      { t: "file() na configuração", s: "o tofu LÊ o valor", end: "terraform.tfstate, em texto puro", cls: "dg-box--warn", verdict: "vaza no estado" },
      { t: "caminho em <VAR>_FILE", s: "o tofu passa o CAMINHO", end: "só o container abre o arquivo", cls: "dg-box--accent", verdict: "não vaza" },
    ],
    sens: "sensitive = true esconde da TELA, e não do arquivo",
    enc: "cifragem de estado (OpenTofu 1.7+) resolve a 2ª linha, não a 1ª",
    measured: "medido pelo portão: 2 ocorrências em claro na 2ª · 0 na 3ª",
    caption:
      "Três caminhos para a mesma senha, e três destinos diferentes. A convenção <code>&lt;VAR&gt;_FILE</code> deste repositório é a única em que o <code>tofu</code> <b>nunca lê o valor</b> — e o que não é lido não pode ser gravado. <code>sensitive = true</code> não pertence a esta figura: ele muda o que aparece na tela, não o que entra no arquivo. A cifragem de estado protege a segunda linha; ela não conserta a primeira, porque lá o segredo já saiu por outra porta.",
    alt: "Três caminhos de um segredo — environment, file() e caminho por VAR_FILE — com onde cada um termina.",
  },
  en: {
    src: "the password, in a file",
    paths: [
      { t: "environment:", s: "the value becomes a variable", end: "docker inspect · /proc/pid/environ · state", cls: "dg-box--danger", verdict: "leaks in three places" },
      { t: "file() in the configuration", s: "tofu READS the value", end: "terraform.tfstate, in plaintext", cls: "dg-box--warn", verdict: "leaks into state" },
      { t: "a path in <VAR>_FILE", s: "tofu passes the PATH", end: "only the container opens the file", cls: "dg-box--accent", verdict: "does not leak" },
    ],
    sens: "sensitive = true hides it from the SCREEN, not from the file",
    enc: "state encryption (OpenTofu 1.7+) fixes the 2nd row, not the 1st",
    measured: "measured by the gate: 2 plaintext hits on row 2 · 0 on row 3",
    caption:
      "Three paths for the same password, and three different destinations. This repository's <code>&lt;VAR&gt;_FILE</code> convention is the only one where <code>tofu</code> <b>never reads the value</b> — and what is never read cannot be written down. <code>sensitive = true</code> does not belong in this figure: it changes what appears on screen, not what enters the file. State encryption protects the second row; it does not fix the first, because there the secret already left through another door.",
    alt: "Three paths for a secret — environment, file() and a path via VAR_FILE — and where each one ends.",
  },
}[lang];
---
<Figure caption={C.caption} alt={C.alt}>
  <svg viewBox="0 0 700 276" xmlns="http://www.w3.org/2000/svg" font-size="11">
    <defs>
      <marker id="sp-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="dg-fill-accent" />
      </marker>
    </defs>

    <rect x="14" y="94" width="130" height="44" rx="8" class="dg-box dg-box--raised" />
    <text x="79" y="112" text-anchor="middle" class="dg-title" font-size="10.5">{C.src}</text>
    <text x="79" y="128" text-anchor="middle" class="dg-mono dg-faint" font-size="8.5">stack/secrets/</text>

    {C.paths.map((p, i) => (
      <g>
        <path d={`M144 116 q40 0 40 ${-70 + i * 70}`} class="dg-line dg-line--accent" fill="none" marker-end="url(#sp-a)" />
        <rect x={190} y={22 + i * 76} width={222} height={52} rx={7} class={`dg-box ${p.cls}`} />
        <text x={206} y={44 + i * 76} class="dg-mono dg-title" font-size="10.5">{p.t}</text>
        <text x={206} y={60 + i * 76} class="dg-faint" font-size="9">{p.s}</text>

        <path d={`M412 ${48 + i * 76} L444 ${48 + i * 76}`} class="dg-line dg-line--accent" fill="none" marker-end="url(#sp-a)" />
        <text x={450} y={44 + i * 76} class="dg-faint" font-size="9">{p.end}</text>
        <text x={450} y={60 + i * 76} class="dg-muted" font-size="9" font-weight="620">{p.verdict}</text>
      </g>
    ))}

    <text x="14" y="228" class="dg-faint" font-size="9.5">{C.sens}</text>
    <text x="14" y="244" class="dg-faint" font-size="9.5">{C.enc}</text>
    <text x="14" y="264" class="dg-muted" font-size="9.5" font-weight="620">{C.measured}</text>
  </svg>
</Figure>
