---
/** k8s-01 — a única ideia nova que um orquestrador traz. */
import Figure from "../Figure.astro";
import type { Lang } from "../../i18n/ui";

const lang: Lang = Astro.url.pathname.startsWith("/en/") ? "en" : "pt";
const C = {
  pt: {
    desired: "estado desejado", desiredNote: "replicas: 2, no deployment.yaml",
    actual: "estado observado", actualNote: "o que existe agora no cluster",
    diff: "diferença", diffNote: "falta 1 pod",
    act: "agir", actNote: "cria o pod que falta",
    controller: "controller",
    forever: "para sempre, a cada mudança",
    compose: "Compose: up converge uma vez e termina",
    k8sm: "Kubernetes: o laço nunca termina",
    measured: "medido: pod recriado 2 s depois do kill",
    caption:
      "O <code>docker compose up</code> é um <b>comando</b>: roda, converge uma vez e sai. O Deployment é um <b>laço</b>: alguém compara desejado com observado para sempre. Matar um pod não é um incidente, é só mais uma iteração desse laço — daí a auto-cura.",
    alt: "Laço de reconciliação: estado desejado, estado observado, diferença e ação.",
  },
  en: {
    desired: "desired state", desiredNote: "replicas: 2, in deployment.yaml",
    actual: "observed state", actualNote: "what exists in the cluster right now",
    diff: "difference", diffNote: "one pod missing",
    act: "act", actNote: "creates the missing pod",
    controller: "controller",
    forever: "forever, on every change",
    compose: "Compose: up converges once and finishes",
    k8sm: "Kubernetes: the loop never finishes",
    measured: "measured: pod recreated 2 s after the kill",
    caption:
      "<code>docker compose up</code> is a <b>command</b>: it runs, converges once and exits. A Deployment is a <b>loop</b>: something compares desired against observed forever. Killing a pod is not an incident, just another iteration of that loop — hence self-healing.",
    alt: "Reconciliation loop: desired state, observed state, difference and action.",
  },
}[lang];

const nodes = [
  { x: 262, y: 14, w: 176, label: C.desired, note: C.desiredNote, cls: "dg-box--accent" },
  { x: 496, y: 92, w: 188, label: C.diff, note: C.diffNote, cls: "dg-box--warn" },
  { x: 262, y: 170, w: 176, label: C.act, note: C.actNote, cls: "dg-box--raised" },
  { x: 16, y: 92, w: 188, label: C.actual, note: C.actualNote, cls: "dg-box--raised" },
];
---
<Figure caption={C.caption} alt={C.alt}>
  <svg viewBox="0 0 700 250" xmlns="http://www.w3.org/2000/svg" font-size="11">
    <defs>
      <marker id="rl-arrow" viewBox="0 0 10 10" refX="8" refY="5"
              markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="dg-fill-accent" />
      </marker>
    </defs>

    <path d="M438 40 q70 10 70 70" class="dg-line dg-line--accent" fill="none" marker-end="url(#rl-arrow)" />
    <path d="M590 146 q0 60 -152 60" class="dg-line dg-line--accent" fill="none" marker-end="url(#rl-arrow)" />
    <path d="M262 196 q-140 0 -152 -46" class="dg-line dg-line--accent" fill="none" marker-end="url(#rl-arrow)" />
    <path d="M110 92 q0 -52 152 -52" class="dg-line dg-line--accent" fill="none" marker-end="url(#rl-arrow)" />

    {nodes.map((n) => (
      <g>
        <rect x={n.x} y={n.y} width={n.w} height={54} rx={8} class={`dg-box ${n.cls}`} />
        <text x={n.x + n.w / 2} y={n.y + 24} text-anchor="middle" class="dg-title" font-size="12">{n.label}</text>
        <text x={n.x + n.w / 2} y={n.y + 40} text-anchor="middle" class="dg-faint" font-size="9.5">{n.note}</text>
      </g>
    ))}

    <text x="350" y="116" text-anchor="middle" class="dg-mono dg-muted" font-size="11" font-weight="620">
      {C.controller}
    </text>
    <text x="350" y="132" text-anchor="middle" class="dg-faint" font-size="9.5">{C.forever}</text>
    <text x="350" y="150" text-anchor="middle" class="dg-faint" font-size="9.5">{C.measured}</text>

    <text x="16" y="240" class="dg-faint" font-size="9.5">{C.compose}</text>
    <text x="684" y="240" text-anchor="end" class="dg-muted" font-size="9.5" font-weight="620">{C.k8sm}</text>
  </svg>
</Figure>
