---
/** Lição cicd-03 — o que o controller guarda, e o que o agente alcança. */
import Figure from "../Figure.astro";
import type { Lang } from "../../i18n/ui";

const lang: Lang = Astro.url.pathname.startsWith("/en/") ? "en" : "pt";
const C = {
  pt: {
    ctrl: "controller", ctrlNota: "0 executores",
    guarda: ["credenciais", "configuração", "histórico dos builds"],
    agent: "agente", agentNota: "onde o build roda",
    tem: ["buildctl", "git", "trivy", "cosign"],
    naoTem: ["docker CLI", "docker.sock", "privilégio", "root"],
    buildkit: "buildkitd", bkNota: "rootless, container_engine_t",
    ws: "WebSocket",
    sock: "socket Unix",
    semTcp: "porta TCP de agente: -1",
    caption:
      "O controller agenda e guarda segredo; o agente constrói. Se um build rodasse no controller ele teria o mesmo acesso ao disco que o processo do Jenkins — logo, às credenciais dele. <b>Os 0 executores são a fronteira</b>, e o portão a verifica a cada execução.",
    alt: "Topologia do módulo: controller com 0 executores, agente sem socket, buildkitd rootless.",
  },
  en: {
    ctrl: "controller", ctrlNota: "0 executors",
    guarda: ["credentials", "configuration", "build history"],
    agent: "agent", agentNota: "where builds run",
    tem: ["buildctl", "git", "trivy", "cosign"],
    naoTem: ["docker CLI", "docker.sock", "privilege", "root"],
    buildkit: "buildkitd", bkNota: "rootless, container_engine_t",
    ws: "WebSocket",
    sock: "Unix socket",
    semTcp: "agent TCP port: -1",
    caption:
      "The controller schedules and holds secrets; the agent builds. A build running on the controller would have the same filesystem access as the Jenkins process — and therefore its credentials. <b>The 0 executors are the boundary</b>, and the gate checks it on every run.",
    alt: "Module topology: controller with 0 executors, agent with no socket, rootless buildkitd.",
  },
}[lang];
---
<Figure caption={C.caption} alt={C.alt}>
  <svg viewBox="0 0 700 214" xmlns="http://www.w3.org/2000/svg" font-size="11">
    <defs>
      <marker id="ca-arrow" viewBox="0 0 10 10" refX="8.5" refY="5"
              markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--border-strong)" />
      </marker>
    </defs>

    <rect x={10} y={22} width={186} height={130} rx={8} class="dg-box dg-box--raised" />
    <text x={103} y={42} text-anchor="middle" class="dg-mono" font-weight="620" font-size="12">{C.ctrl}</text>
    <text x={103} y={57} text-anchor="middle" class="dg-fill-danger" font-weight="620" font-size="10">{C.ctrlNota}</text>
    {C.guarda.map((g, i) => (
      <text x={26} y={80 + i * 17} class="dg-muted" font-size="9.5">· {g}</text>
    ))}
    <text x={103} y={140} text-anchor="middle" class="dg-faint" font-size="8.5">{C.semTcp}</text>

    <rect x={262} y={22} width={186} height={130} rx={8} class="dg-box dg-box--accent" />
    <text x={355} y={42} text-anchor="middle" class="dg-mono" font-weight="620" font-size="12">{C.agent}</text>
    <text x={355} y={57} text-anchor="middle" class="dg-faint" font-size="9.5">{C.agentNota}</text>
    {C.tem.map((g, i) => (
      <text x={278} y={80 + i * 15} class="dg-muted" font-size="9">✓ {g}</text>
    ))}
    {C.naoTem.map((g, i) => (
      <text x={370} y={80 + i * 15} class="dg-fill-danger" font-size="9">✗ {g}</text>
    ))}

    <rect x={514} y={44} width={176} height={86} rx={8} class="dg-box dg-box--dashed" />
    <text x={602} y={72} text-anchor="middle" class="dg-mono" font-weight="620" font-size="12">{C.buildkit}</text>
    <text x={602} y={90} text-anchor="middle" class="dg-faint" font-size="9">{C.bkNota}</text>

    <path d="M200 76 L256 76" class="dg-line" marker-end="url(#ca-arrow)" />
    <text x={228} y={68} text-anchor="middle" class="dg-mono dg-muted" font-size="8.5">{C.ws}</text>
    <path d="M452 88 L508 88" class="dg-line dg-line--accent" marker-end="url(#ca-arrow)" />
    <text x={480} y={80} text-anchor="middle" class="dg-mono dg-muted" font-size="8.5">{C.sock}</text>

    <text x={10} y={178} class="dg-faint" font-size="9">
      {lang === "pt"
        ? "O agente entra por WebSocket sobre a mesma porta da UI: não há segunda porta publicada só para ele."
        : "The agent connects over WebSocket on the UI's own port: there is no second published port just for it."}
    </text>
    <text x={10} y={196} class="dg-faint" font-size="9">
      {lang === "pt"
        ? "Um RUN de um pull request executa no agente — e o que ele alcança é um container rootless, não a máquina."
        : "A RUN from a pull request executes on the agent — and what it reaches is a rootless container, not the machine."}
    </text>
  </svg>
</Figure>
