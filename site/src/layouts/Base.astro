---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { useTranslations, otherLang, languages, repoUrl, TRACKS, type Lang, type Track } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Caminho equivalente no outro idioma, para o seletor. */
  altPath?: string;
  /** Mostra a barra de progresso de leitura. Só faz sentido em página longa. */
  progress?: boolean;
}

const { lang, title, description, altPath, progress = false } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const alt = altPath ?? `/${other}/`;
const currentPath = Astro.url.pathname;

// As trilhas da nav saem de TRACKS, e só entram as que TÊM lição neste idioma.
// Antes eram dois literais escritos à mão — e a trilha de Segurança nasceu
// invisível na barra por causa disso, mesmo com seis lições publicadas. Uma
// trilha vazia continua fora: mandar o leitor para uma âncora sem conteúdo é
// pior do que não oferecer o link.
const doIdioma = await getCollection("lessons", (e) => e.data.lang === lang);
const navTracks = TRACKS.filter((tr) => doIdioma.some((e) => e.data.track === tr)) as Track[];
---

<!doctype html>
<html lang={lang === "pt" ? "pt-BR" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? t("site.description")} />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    <!-- Diz aos buscadores que estas duas URLs são a mesma página em idiomas
         diferentes, em vez de conteúdo duplicado. -->
    <link rel="alternate" hreflang={other === "pt" ? "pt-BR" : "en"} href={new URL(alt, Astro.site)} />
    <link rel="alternate" hreflang={lang === "pt" ? "pt-BR" : "en"} href={new URL(currentPath, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? t("site.description")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "pt" ? "pt_BR" : "en_US"} />
    <meta name="theme-color" content="#0b6b5e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131315" media="(prefers-color-scheme: dark)" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230b6b5e'/%3E%3Cpath d='M8 20h16M8 15h16M8 10h16' stroke='white' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E"
    />
    <script is:inline>
      // Roda ANTES da primeira pintura: sem isto, a página aparece clara por um
      // frame antes do JS trocar para o tema escuro salvo. É o mesmo motivo pelo
      // qual um container deve estar pronto ANTES de entrar no balanceador.
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.dataset.theme = saved;
          }
        } catch { /* localStorage bloqueado: fica no padrão do sistema */ }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">{t("a11y.skip")}</a>

    {progress && (
      <div class="progress" aria-hidden="true"><div class="progress__bar" id="progress-bar"></div></div>
    )}

    <header class="nav">
      <div class="shell nav__inner">
        <a class="nav__brand" href={`/${lang}/`}>
          <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="var(--accent)"></rect>
            <path d="M8 20h16M8 15h16M8 10h16" stroke="var(--bg)" stroke-width="2.4" stroke-linecap="round"></path>
          </svg>
          {t("site.title")}
        </a>

        <nav class="nav__links" aria-label={t("nav.tracks")}>
          <a class="nav__link" href={`/${lang}/`} aria-current={currentPath === `/${lang}/` ? "page" : undefined}>
            {t("nav.home")}
          </a>
          {navTracks.map((tr) => (
            <a class="nav__link nav__link--optional" href={`/${lang}/#${tr}`}>{t(`track.${tr}`)}</a>
          ))}
        </nav>

        <span class="nav__spacer"></span>

        <div class="nav__group">
          <a class="nav__icon-link" href={repoUrl} rel="noopener noreferrer" target="_blank" title={t("nav.repo")}>
            <span class="visually-hidden">{t("nav.repo")}</span>
            <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                       0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01
                       1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
                       0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68
                       0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0
                       3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01
                       8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
            </svg>
          </a>

          <a class="btn btn-ghost" href={alt} hreflang={other} title={t("lang.switch")}>
            {languages[other]}
          </a>

          <button class="btn btn-ghost btn--icon btn--sm" id="theme-toggle" type="button"
                  aria-label={t("nav.theme")} aria-pressed="false">
            <svg class="icon-light" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <svg class="icon-dark" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="footer">
      <div class="shell footer__inner">
        <p style="margin: 0;">{t("footer.built")}</p>
        <div class="footer__links">
          <a href={repoUrl} rel="noopener noreferrer" target="_blank">GitHub</a>
          <a href={alt} hreflang={other}>{languages[other]}</a>
        </div>
      </div>
    </footer>

    <script is:inline define:vars={{ copyLabel: t("action.copy"), copiedLabel: t("action.copied"), copyTitle: t("action.copyCode") }}>
      // ── Tema ────────────────────────────────────────────────────────────────
      const root = document.documentElement;
      const resolved = () =>
        root.dataset.theme ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

      const toggle = document.getElementById("theme-toggle");
      if (toggle) {
        // aria-pressed diz ao leitor de tela QUAL é o estado atual. Sem isto o
        // botão anuncia só "alternar tema", sem dizer para onde.
        toggle.setAttribute("aria-pressed", String(resolved() === "dark"));
        toggle.addEventListener("click", () => {
          const next = resolved() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          toggle.setAttribute("aria-pressed", String(next === "dark"));
          try { localStorage.setItem("theme", next); } catch { /* ignorado */ }
        });
      }

      // ── Copiar bloco de código ──────────────────────────────────────────────
      // Melhoria progressiva: sem JS o bloco continua igual, só não ganha botão.
      // Todo comando das lições é feito para ser colado num terminal — copiar à
      // mão de um <pre> com rolagem horizontal perde o fim da linha calado.
      for (const pre of document.querySelectorAll(".prose pre, .runit pre")) {
        if (pre.parentElement?.classList.contains("code-wrap")) continue;
        const wrap = document.createElement("div");
        wrap.className = "code-wrap";
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn btn-ghost copy-btn";
        btn.textContent = copyLabel;
        btn.title = copyTitle;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ""));
            btn.textContent = copiedLabel;
            btn.classList.add("is-done");
            setTimeout(() => { btn.textContent = copyLabel; btn.classList.remove("is-done"); }, 1600);
          } catch {
            // Clipboard negado (http sem localhost, permissão): selecionar o
            // texto ainda deixa o leitor copiar com Ctrl+C.
            const range = document.createRange();
            range.selectNodeContents(pre);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          }
        });
        wrap.appendChild(btn);
      }

      // ── Progresso de leitura + TOC ativa ────────────────────────────────────
      const bar = document.getElementById("progress-bar");
      const article = document.querySelector(".prose");
      if (bar && article) {
        const update = () => {
          const start = article.offsetTop;
          const span = article.offsetHeight - window.innerHeight;
          const pct = span <= 0 ? 100 : ((window.scrollY - start) / span) * 100;
          bar.style.setProperty("--progress", `${Math.min(100, Math.max(0, pct))}%`);
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
      }

      // Marca no índice lateral a seção que está na tela. Sem isto, numa lição
      // de 300 linhas o índice não diz onde você está.
      const tocLinks = new Map();
      for (const a of document.querySelectorAll(".toc a[href^='#']")) {
        tocLinks.set(decodeURIComponent(a.getAttribute("href").slice(1)), a);
      }
      if (tocLinks.size > 0 && "IntersectionObserver" in window) {
        const seen = new Set();
        const mark = () => {
          for (const [id, a] of tocLinks) a.setAttribute("aria-current", seen.has(id) ? "true" : "false");
        };
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) seen.add(e.target.id);
              else seen.delete(e.target.id);
            }
            mark();
          },
          { rootMargin: "-20% 0px -70% 0px" },
        );
        for (const id of tocLinks.keys()) {
          const heading = document.getElementById(id);
          if (heading) io.observe(heading);
        }
      }
    </script>
  </body>
</html>
