---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import GateRunner from "../../components/islands/GateRunner.tsx";
import SkillCoverage from "../../components/SkillCoverage.astro";
import MarketDemand from "../../components/diagrams/MarketDemand.astro";
import { useTranslations, otherLang, repoUrl, TRACKS, trackBadge, type Lang, type Track } from "../../i18n/ui";
import measured from "../../data/measured.json";

export async function getStaticPaths() {
  return [{ params: { lang: "pt" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const all = await getCollection("lessons", (e) => e.data.lang === lang);
const byTrack = (track: Track) =>
  all.filter((e) => e.data.track === track).sort((a, b) => a.data.order - b.data.order);

// A lista sai de TRACKS (i18n/ui.ts), que é a ordem canônica da jornada.
// Antes era um array literal aqui, e uma trilha nova exigia lembrar dele.
const tracks = TRACKS.map((id) => ({ id, badge: trackBadge(id), lessons: byTrack(id) }));
const first = tracks[0].lessons[0];

// Os números da vitrine saem dos dados medidos, não de um literal na página.
// Um número escrito à mão aqui começa certo e envelhece errado sem avisar.
const smallest = Math.min(...measured.images.map((i) => i.bytes));
const stats = [
  { value: String(all.length), label: t("home.lessons") },
  { value: String(measured.images.length), label: t("home.stats.images") },
  { value: `${(smallest / 1_048_576).toFixed(1)} MB`, label: lang === "pt" ? "a menor imagem" : "the smallest image" },
  { value: String(new Set(measured.images.map((i) => i.language)).size), label: t("home.stats.langs") },
];
---

<Base
  lang={lang}
  title={`${t("site.title")} — ${t("site.tagline")}`}
  altPath={`/${otherLang(lang)}/`}
>
  <section class="hero">
    <div class="hero__inner">
      <span class="hero__eyebrow">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m5 13 4 4L19 7"></path>
        </svg>
        {lang === "pt" ? "medido, não copiado de blog" : "measured, not copied from a blog"}
      </span>
      <h1>{t("site.tagline")}</h1>
      <p class="hero__lead">{t("home.intro")}</p>

      <div class="hero__actions">
        {first && (
          <a class="btn btn--primary btn--lg" href={`/${lang}/lessons/${first.data.key}/`}>
            {t("home.start")}
            <span aria-hidden="true">→</span>
          </a>
        )}
        <a class="btn btn--secondary btn--lg" href="#verify">
          {t("home.verify.title")}
        </a>
        <a class="btn btn--lg" href={repoUrl} rel="noopener noreferrer" target="_blank">
          GitHub
        </a>
      </div>
    </div>

    <div class="stats">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat__value">{s.value}</span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  {tracks.map((track) => (
    <section class={`track-section ${track.lessons.length === 0 ? "track-section--empty" : ""}`} id={track.id}>
      <h2 class="track-section__head">
        <span class={`badge ${track.badge}`}>{t(`track.${track.id}`)}</span>
        <span class="track-section__count">
          {track.lessons.length > 0 ? `${track.lessons.length} ${t("home.lessons")}` : "—"}
        </span>
      </h2>
      <p class="track-section__desc">{t(`track.${track.id}.desc`)}</p>

      {track.lessons.length > 0 ? (
        <div class="grid grid--2">
          {track.lessons.map((lesson) => (
            <a class="card" href={`/${lang}/lessons/${lesson.data.key}/`}>
              <div class="card__meta">
                <span>{t("lesson.lesson")} {lesson.data.order}</span>
                <span>·</span>
                <span>{lesson.data.minutes} {t("lesson.minutes")}</span>
              </div>
              <h3 class="card__title">{lesson.data.title}</h3>
              <p class="card__summary">{lesson.data.summary}</p>
              {lesson.data.tags.length > 0 && (
                <div class="card__tags">
                  {lesson.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
                </div>
              )}
              <span class="card__foot">
                {lesson.data.title.length > 0 && (lang === "pt" ? "Ler" : "Read")}
                <span class="card__arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="soon">{t("home.soon")}</p>
      )}
    </section>
  ))}

  <!-- O mapa de mercado. Ele fica na home, e não numa lição, porque é uma
       afirmação sobre o REPOSITÓRIO INTEIRO — e porque um roadmap escondido
       dentro de uma trilha é um roadmap que ninguém lê. A honestidade dele é
       guardada por site/tests/skills.test.ts (ADR 0014). -->
  <section class="track-section" id="market">
    <h2 class="track-section__head">{t("home.market.title")}</h2>
    <p class="track-section__desc">{t("home.market.desc")}</p>
    <MarketDemand />
    <SkillCoverage />
  </section>

  <!-- As checagens do portão, disparadas pelo navegador. Com a stack no ar
       elas são requisições de verdade; sem ela, a gravação do último portão. -->
  <section class="track-section" id="verify">
    <h2 class="track-section__head">{t("home.verify.title")}</h2>
    <p class="track-section__desc">{t("home.verify.desc")}</p>
    <GateRunner client:visible lang={lang} />
  </section>
</Base>
