---
// Raiz do site. Como a build é ESTÁTICA, não existe servidor para devolver um
// 302 — então a raiz é uma página real que redireciona no cliente.
//
// A ordem importa para acessibilidade e para buscadores:
//   1. <link rel="canonical"> aponta o idioma padrão como a versão oficial;
//   2. <meta http-equiv="refresh"> faz o redirecionamento sem JavaScript;
//   3. um link visível serve de fallback se as duas coisas falharem.
import { defaultLang, languages } from "../i18n/ui";

const target = `/${defaultLang}/`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    {Object.keys(languages).map((code) => (
      <link rel="alternate" hreflang={code === "pt" ? "pt-BR" : code} href={new URL(`/${code}/`, Astro.site)} />
    ))}
    <title>infra-knowlogy</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>
      Redirecionando para <a href={target}>{target}</a> …
      <br />
      <a href="/en/">Read in English</a>
    </p>
  </body>
</html>
